{
  "name": "advard",
  "productName": "AdVard",
  "author": "AdVard",
  "private": true,
  "type": "module",
  "version": "3.7.8",
  "description": "All-in-one desktop controller and file manager for Android devices.",
  "main": "dist/electron/main.mjs",
  "scripts": {
    "dev": "concurrently -k -n \"VITE,ELECTRON\" -c \"cyan,yellow\" \"vite\" \"wait-on http://localhost:5173 && npm run build:electron && node scripts/start-electron.js .\"",
    "dev:web": "vite",
    "build": "vite build && npm run build:electron",
    "build:electron": "tsc -p tsconfig.node.json && tsc -p tsconfig.preload.json && node scripts/build-electron.js",
    "build:renderer": "vite build",
    "dist": "npm run build && electron-builder -c electron-builder.config.js",
    "dist:mac": "npm run build && electron-builder --mac -c electron-builder.config.js",
    "dist:win": "node scripts/dist-win.js",
    "dist:linux": "npm run build && electron-builder --linux -c electron-builder.config.js",
    "electron": "node scripts/start-electron.js .",
    "start": "npm run dev",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@types/qrcode": "^1.5.6",
    "lucide-react": "^0.511.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.15.34",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "autoprefixer": "^10.4.21",
    "concurrently": "^10.0.4",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "postcss": "^8.5.5",
    "tailwindcss": "^3.4.17",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "vite": "^8.2.0",
    "wait-on": "^9.1.0"
  }
}
